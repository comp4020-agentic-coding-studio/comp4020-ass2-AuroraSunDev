node_modules/
dist/
*.log

# Astro's generated types and build cache
.astro/

# staging dir for the CI link check
linkcheck/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Local QA renders --- screenshots, candidate generations, crops. Output,
# never committed, and kept apart from design-references/, which are approved
# inputs. Around 90M of it.
.qa/*

# The instruments are not output. They are how the viewport, contrast,
# overflow and clipping claims in PROCESS.md were measured, and a claim whose
# instrument is missing cannot be rechecked. 84K of code.
!.qa/tools/

# Intermediates from scripts/compose-social-card.mjs. The card itself is
# committed; these are the page and screenshot it is rendered through.
.card.tmp.*
