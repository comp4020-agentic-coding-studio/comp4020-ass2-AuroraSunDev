---
/**
 * One assessment brief.
 *
 * plan.md's shared anatomy is the brief's own markdown --- number, title,
 * weight, capability, due date, proposition, task at a glance, the brief,
 * required submission, recommended process, evidence standard, equivalent
 * participation, safety, and preparation. This route supplies the three things
 * that cannot live in markdown: the header block with the facts read from
 * frontmatter, the dominant artefact that has to differ between the four, and
 * the previous / all / next navigation the plan requires at the foot.
 *
 * The marking table renders from frontmatter below the body, which is why no
 * brief writes its own `## Marking` heading.
 */
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import Callout from "astro-theme-university/components/Callout.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { withBase } from "astro-theme-university/url";
import ArchiveRule from "../../components/course/ArchiveRule.astro";
import AssessmentArtefact from "../../components/course/AssessmentArtefact.astro";
import MarkingModel from "../../components/MarkingModel.astro";
import { courseMeta } from "../../course-config";
import { formatCourseDate } from "../../lib/dates";
import { ASSESSMENTS } from "../../lib/semester";
import { graphCollections, siteConfig } from "../../site-config";
import "../../styles/page.css";
import "../../styles/assessments.css";

export async function getStaticPaths() {
  const assessments = await getPublishedCollection("assessments");
  return assessments.map((assessment) => ({
    params: { slug: assessment.id },
    props: { assessment },
  }));
}

const { assessment } = Astro.props;
const { Content } = await render(assessment);

/* The semester table fixes the order of the four, which is what previous and
   next mean here --- not alphabetical order, and not collection order. */
const index = ASSESSMENTS.findIndex((a) => a.slug === assessment.id);
const record = ASSESSMENTS[index];
const prev = index > 0 ? ASSESSMENTS[index - 1] : undefined;
const next = index < ASSESSMENTS.length - 1 ? ASSESSMENTS[index + 1] : undefined;

const built = new Set((await getPublishedCollection("assessments")).map((a) => a.id));
const hrefFor = (slug?: string) =>
  slug && built.has(slug) ? withBase(`/assessments/${slug}/`) : undefined;

/* The artefact that opens each brief, and the one-line note that says what it
   is. plan.md requires these four to differ; the drawing is chosen by slug so
   a new assessment cannot silently reuse another's. */
const FIGCAP: Record<string, string> = {
  "field-log": "Observation sheet — one of four entries, blank",
  "component-test": "Comparison bench — three conditions and one control",
  "failure-autopsy": "Evidence board — case 11, with one branch unresolved",
  final: "Load-case brief and iteration record",
};

const n = String(index + 1).padStart(2, "0");
const capability = record?.capability ?? "";
---

<BaseLayout
  title={`${assessment.data.title} — ${courseMeta.code}`}
  description={assessment.data.description ?? undefined}
  {...siteConfig}
  mainAttrs={{ class: "slop-page brief" }}
>
  {/* --- Header block ---------------------------------------------------- */}
  <section class="band band--tight" aria-labelledby="brief-title">
    <div class="inner">
      <div class="brief-head">
        <div>
          <p class="brief-n display" aria-hidden="true">{n}</p>
          <p class="eyebrow">
            Assessment {n} of {ASSESSMENTS.length}
            {capability && <> — {capability}</>}
          </p>
          <h1 id="brief-title" class="page-title brief-title">{assessment.data.title}</h1>

          <p class="brief-facts">
            <span class="mono"><b>{assessment.data.weight}%</b> of the total mark</span>
            <span class="mono">Due {formatCourseDate(assessment.data.due)}</span>
            <span class="mono">End of Week {assessment.data.week}</span>
            <span class="mono">Individual</span>
          </p>

          {record && <p class="brief-prop">{record.summary}</p>}

          {assessment.data.draft && (
            <Callout type="warning">
              <p>
                <strong>Draft.</strong> This brief is still being finalised and may
                change.
              </p>
            </Callout>
          )}
        </div>

        <figure class="brief-fig">
          <AssessmentArtefact slug={assessment.id as any} labelled />
          <figcaption class="brief-figcap mono">{FIGCAP[assessment.id]}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* --- The brief itself ------------------------------------------------ */}
  <section class="band" aria-labelledby="body-title">
    <div class="inner inner--reading">
      <h2 id="body-title" class="visually-hidden">The brief</h2>
      <div class="slop-measure">
        <Content />
      </div>

      <SpecList spec={assessment.data.spec}>
        The brief poses the problem and leaves room for a response. The spec is
        the fixed part: what a marker checks.
      </SpecList>

      {assessment.data.marking && <MarkingModel marking={assessment.data.marking} />}

      <RelatedContent entry={assessment} collections={graphCollections} />
    </div>
  </section>

  {/* --- Assessment navigation ------------------------------------------- */}
  <section class="band band--last" aria-labelledby="nav-title">
    <div class="inner">
      <h2 id="nav-title" class="eyebrow eyebrow--ruled">Assessment navigation</h2>
      <nav class="brief-nav" aria-label="Assessments">
        <div>
          <span class="bn-k">Previous</span>
          {prev ? (
            hrefFor(prev.slug) ? (
              <a href={hrefFor(prev.slug)}>{prev.title} — {prev.weight}%</a>
            ) : (
              <span class="pending">{prev.title} <em>in preparation</em></span>
            )
          ) : (
            <span class="pending">This is the first submission</span>
          )}
        </div>

        <div class="bn-mid">
          <span class="bn-k">All</span>
          <a href={withBase("/assessments/")}>The four submissions</a>
        </div>

        <div class="bn-end">
          <span class="bn-k">Next</span>
          {next ? (
            hrefFor(next.slug) ? (
              <a href={hrefFor(next.slug)}>{next.title} — {next.weight}%</a>
            ) : (
              <span class="pending">{next.title} <em>in preparation</em></span>
            )
          ) : (
            <span class="pending">This is the final submission</span>
          )}
        </div>
      </nav>

      <ArchiveRule label={`${courseMeta.code} / assessment ${n} / ${assessment.data.weight}%`} />
    </div>
  </section>
</BaseLayout>
