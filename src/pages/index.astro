---
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import ArchiveRule from "../components/course/ArchiveRule.astro";
import SpecimenLabel from "../components/course/SpecimenLabel.astro";
import Stamp from "../components/course/Stamp.astro";
import FailureDiagram from "../components/home/FailureDiagram.astro";
import FieldManual from "../components/home/FieldManual.astro";
import LayerOrderStack from "../components/home/LayerOrderStack.astro";
import LectureSleeve from "../components/home/LectureSleeve.astro";
import SpecimenRig from "../components/home/SpecimenRig.astro";
import SpecimenSection from "../components/home/SpecimenSection.astro";
import { courseMeta } from "../course-config";
import { formatCourseDate } from "../lib/dates";
import { ASSESSMENTS, PHASES, TOTAL_WEIGHT, WEEKS } from "../lib/semester";
import { siteConfig } from "../site-config";
import "../styles/home.css";

// Every internal link on this page is guarded by what actually built. A route
// whose page does not exist yet renders as plain text with an "in preparation"
// note rather than a link --- the build's link checker would fail on the
// alternative, and a marker clicking a dead link is worse than a marker
// reading that a page is still coming.
const sessions = await getPublishedCollection("sessions");

/* Which weeks carry a slide deck. Read from the lectures collection rather
   than kept as a flag beside the week: it was a flag, `lecture: true` was set
   on Week 4 alone, and when Week 8 gained a deck the badge did not follow it
   here or on the homepage --- and the legend below went on saying Week 4 was
   the only one. A `slides:` frontmatter field is the fact; anything else is a
   second copy of it waiting to disagree. */
const lectures = await getPublishedCollection("lectures");
const deckWeeks = new Set(
  lectures.filter((l) => l.data.slides).map((l) => l.data.week as number),
);
const builtWeeks = new Set(sessions.map((s) => s.id));

const FAMILIES = [
  {
    id: "slip", n: "01", name: "Slip",
    line: "Layers move laterally.",
    before: "Friction holds the interface.",
    after: "Shear overcomes friction. Layers slide.",
    week: 3,
  },
  {
    id: "soak", n: "02", name: "Soak",
    line: "Moisture advances.",
    before: "The boundary is dry.",
    after: "The moisture front moves. Strength degrades.",
    week: 4,
  },
  {
    id: "crush", n: "03", name: "Crush",
    line: "Compression closes gaps.",
    before: "The stack carries its own height.",
    after: "Load shortens the stack. Gaps collapse.",
    week: 2,
  },
  {
    id: "splay", n: "04", name: "Splay",
    line: "Exposed edges expand.",
    before: "Contents sit inside the boundary.",
    after: "Unbraced edges flare. The structure opens.",
    week: 5,
  },
] as const;

const weekOf = (n: number) => WEEKS.find((w) => w.week === n)!;
const hrefFor = (slug: string) =>
  builtWeeks.has(slug) ? withBase(`/sessions/${slug}/`) : undefined;
/* How many stations the phone's vertical track shows before it says the rest
   continue. Six is the reference's break, and it is also where Phase II ends,
   so the truncation lands on a structural seam rather than mid-phase. */
const TRACK_STATIONS = 6;
/* Computed here, not in the template: a bare `<` inside a JSX expression is
   ambiguous with a tag open, and `w.week <= TRACK_STATIONS` in the markup
   parses as an element. */
const TRACK_WEEKS = WEEKS.filter((w) => w.week <= TRACK_STATIONS);

const milestoneAt = (week: number) => ASSESSMENTS.find((a) => a.dueWeek === week);
const maxWeight = Math.max(...ASSESSMENTS.map((a) => a.weight));
---

<BaseLayout
  title={`${courseMeta.code}: ${courseMeta.title} — ${siteConfig.name}`}
  description={courseMeta.description}
  {...siteConfig}
  mainAttrs={{ class: "home" }}
>
  {/* 1 --- FIRST VIEWPORT: the specimen under load ------------------------ */}
  <section class="band band--hero" aria-labelledby="hero-title" data-motion-hero>
    <div class="inner hero">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title">The Sandwich Must Hold</h1>
        <p class="hero-lede">
          Every lunch is a temporary structure.<br />
          Study the forces that make it fail.
        </p>
        <p class="hero-actions">
          {hrefFor("week-01") ? (
            <a class="btn" href={hrefFor("week-01")}>Enter Week 1<span aria-hidden="true">→</span></a>
          ) : (
            <span class="btn btn--pending">Enter Week 1 <em>in preparation</em></span>
          )}
        </p>
        <p class="hero-secondary">
          <a class="linkline" href={withBase("/sessions/")}>View the semester structure<span aria-hidden="true">→</span></a>
        </p>
      </div>

      <figure class="hero-figure">
        <SpecimenRig />
        <figcaption class="readout">
          <SpecimenLabel key="Specimen" value="001" />
          <SpecimenLabel key="Scale" value="50 mm" />
          <SpecimenLabel key="Load case" value="One-handed hold" />
          <span class="status">Test in progress</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* 2 --- THE STRUCTURAL PROPOSITION ------------------------------------- */}
  <section class="band band--ink slop-band--ink" aria-labelledby="prop-title" data-motion-prop>
    <div class="inner prop">
      <div class="prop-copy">
        <h2 id="prop-title" class="display xl">Lunch is a load case.</h2>
        <p class="prop-lede">
          A sandwich is a temporary assembly.<br />
          Every layer is both a material and an interface.
        </p>
        <div class="prop-record">
          <p class="prop-n display">03</p>
          <div>
            <p class="prop-spec">Specimen: grip, friction and slip</p>
            <p class="prop-obs">
              Observed failure: lateral slip at the cheese–meat interface, under
              a shear load applied by one-handed use.
            </p>
          </div>
        </div>
      </div>

      <figure class="prop-figure">
        <SpecimenSection />
        {/* The layer names are drawn beside the specimen on desktop and as
            numbered callouts on the phone, but neither is text a screen reader
            can follow, so the stack is also stated plainly here. */}
        <figcaption class="visually-hidden">
          <p>
            Specimen 003, four layers from the top: bread, cheese, meat — the
            failure interface — and bread. Specimen height approximately 80 mm.
          </p>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* 3 --- FOUR FAILURE FAMILIES ------------------------------------------ */}
  <section class="band" aria-labelledby="fam-title">
    <div class="inner fam-inner">
      <h2 id="fam-title" class="display xl">Four failure families</h2>
      {/* Beside the heading on desktop, under the list on the phone --- the
          reference puts the disclaimer where the reader is looking last. */}
      <p class="caveat">Course working model — not a professional standard.</p>

      <ol class="fam">
        {FAMILIES.map((f) => {
          const week = weekOf(f.week);
          const href = hrefFor(week.slug);
          return (
            <li class="fam-row" data-motion-family={f.id} tabindex="-1">
              <p class="fam-n display">{f.n}</p>
              <div class="fam-name">
                <h3 class="display">{f.name}</h3>
                <p>{f.line}</p>
              </div>
              {/* `display: contents` on desktop, so the two states sit in the
                  row's own tracks either side of the divider; a flex row on the
                  phone, where the reference sets them side by side with an
                  arrow between. */}
              <div class="fam-states">
                <div class="fam-state">
                  <p class="fam-cap">Before load</p>
                  <FailureDiagram family={f.id} state="before" />
                  {/* The diagram is presentational, so the state it shows is
                      also stated in text for anyone who cannot see it. */}
                  <p class="fam-note visually-hidden">{f.before}</p>
                </div>
                <span class="fam-arrow" aria-hidden="true">→</span>
                <div class="fam-state">
                  <p class="fam-cap">After load</p>
                  <FailureDiagram family={f.id} state="after" />
                  <p class="fam-note visually-hidden">{f.after}</p>
                </div>
              </div>

              <div class="fam-out">
                <p class="fam-conseq">{f.after}</p>
                <p class="fam-week">
                  {href ? (
                    <a href={href}>Week {week.week}: {week.title}</a>
                  ) : (
                    <span class="pending">Week {week.week}: {week.title} <em>in preparation</em></span>
                  )}
                </p>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </section>

  {/* 4 --- THE SEMESTER LOAD PATH ----------------------------------------- */}
  <section class="band band--alt" aria-labelledby="sem-title">
    <div class="inner">
      <h2 id="sem-title" class="display xl">Twelve stations. One specimen.</h2>
      <p class="sem-lede">
        From definition to destructive testing, each station isolates one
        condition that determines whether a sandwich holds.
      </p>

      {/* One row, read left to right: the four phases are stages of a single
          load path, not four parallel columns. The week span each covers is
          stated on the stations below, so it is not repeated here. */}
      <ol class="phases">
        {PHASES.map((p, i) => (
          <li class="phase">
            {i > 0 && <span class="phase-arrow" aria-hidden="true">→</span>}
            <span class="phase-body">
              <span class="phase-n">Phase {p.numeral}</span>
              <span class="phase-name display">{p.name}</span>
              <span class="visually-hidden">Weeks {p.weeks[0]} to {p.weeks[1]}</span>
            </span>
          </li>
        ))}
      </ol>

      {/* The section's signature: twelve stations on one rail, with the
          assessment milestones hanging beneath the weeks they fall due in.
          Desktop only, and aria-hidden --- every station's number, title, date
          and milestone is announced by the list below, so exposing the rail
          too would make a screen reader read the semester twice. */}
      {/* One grid, five rows: the station line, the station numbers, whatever
          hangs off a station, the assessment line, and its weights. Everything
          is placed by column so a mark is always under the station it belongs
          to, at any width. */}
      <div class="rail" data-motion-rail aria-hidden="true">
        <p class="rail-label rail-label--stn">Station no.</p>
        <p class="rail-label rail-label--ms">Assessment milestone</p>

        {/* Drawn first so the open stations sit on top of it. */}
        <div class="rail-line"><span></span></div>
        <div class="rail-line rail-line--ms"><span></span></div>

        {WEEKS.map((w) => {
          const milestone = milestoneAt(w.week);
          const col = w.week + 1;
          return (
            <>
              <span
                class:list={["rail-dot", w.week === 1 && "is-start"]}
                style={`grid-column:${col}`}
              ></span>
              <span class="rail-n" style={`grid-column:${col}`}>
                {String(w.week).padStart(2, "0")}
              </span>

              {w.week === 1 && (
                <span class="rail-note rail-note--start" style={`grid-column:${col}`}>
                  <svg viewBox="0 0 10 22" focusable="false"><path d="M5 22 V3 m-4 4 l4 -4 l4 4" /></svg>
                  Specimen<br />at start
                </span>
              )}
              {deckWeeks.has(w.week) && (
                <span class="rail-note rail-deck" style={`grid-column:${col}`}>
                  Lecture<br />deck
                </span>
              )}

              {milestone && (
                <>
                  {/* The milestone hangs off its station: a dotted drop, then
                      the weight on the assessment line. */}
                  <span class="rail-drop" style={`grid-column:${col}`}></span>
                  <span class="rail-ms-dot" style={`grid-column:${col}`}></span>
                  <span class="rail-pct" style={`grid-column:${col}`}>{milestone.weight}%</span>
                </>
              )}
            </>
          );
        })}
      </div>

      {/* The phone's load path. The desktop rail above carries all twelve
          stations in one line; at this width that line becomes a vertical
          track, and a track of twelve full records is longer than the section
          it belongs to. The reference truncates it at six and says so, which
          is honest about there being more and keeps the phone's first
          impression the shape of the path rather than a list of weeks. */}
      <ol class="track" data-motion-track>
        <li class="track-line" aria-hidden="true"><span></span></li>
        {TRACK_WEEKS.map((w) => {
          const href = hrefFor(w.slug);
          const milestone = milestoneAt(w.week);
          const opens = PHASES.find((p) => p.weeks[0] === w.week);
          return (
            <li class="stn">
              {opens && (
                <span class="stn-phase">
                  {opens.name}
                  <span class="visually-hidden">
                    {" "}— Phase {opens.numeral}, weeks {opens.weeks[0]} to {opens.weeks[1]}
                  </span>
                </span>
              )}
              <span class="stn-dot" aria-hidden="true"></span>
              <span class="stn-n display">{String(w.week).padStart(2, "0")}</span>
              <span class="stn-body">
                <span class="stn-title">
                  {href ? <a href={href}>{w.title}</a> : <span class="pending">{w.title}</span>}
                </span>
                <span class="stn-date">{formatCourseDate(w.date)}</span>
              </span>
              <span class="stn-marks">
                {deckWeeks.has(w.week) && <span class="tag tag--deck">Lecture deck</span>}
                {milestone && (
                  <span class="tag tag--milestone">{milestone.title} · {milestone.weight}%</span>
                )}
              </span>
            </li>
          );
        })}
        <li class="stn stn--more">
          <span class="stn-dot stn-dot--break" aria-hidden="true"></span>
          <span class="stn-more-t">
            Stations {String(TRACK_STATIONS + 1).padStart(2, "0")}–{WEEKS.length} continue on the{" "}
            <a href={withBase("/sessions/")}>semester load path</a>.
          </span>
        </li>
      </ol>
      <p class="track-foot">
        Every week's date, structural question and artefact is on the{" "}
        <a href={withBase("/sessions/")}>semester load path</a>.
      </p>
    </div>
  </section>

  {/* 6 --- ASSESSMENT LOAD ------------------------------------------------ *
      The reference runs the semester path straight into the assessment load:
      the stations say what the course does to the specimen, the loads say what
      it asks of the student, and the two axes read as one argument when they
      are adjacent. plan.md's Week 8 specimen study, which used to sit between
      them, now follows --- it is a specimen case rather than a step in that
      argument.                                                              */}
  <section class="band band--alt" aria-labelledby="load-title">
    <div class="inner">
      <h2 id="load-title" class="display xl">The load increases.</h2>
      <p class="sem-lede">
        Assessments scale with the structural load. Prove more, risk more, hold
        stronger. Four submissions, totalling {TOTAL_WEIGHT}%.
      </p>

      {/* The four declared loads standing on one axis. Weight drives the size
          of the figure and the height of its stem, so the increase is a
          physical fact of the drawing rather than a caption. */}
      <div class="loadaxis">
        <p class="loads-axis" aria-hidden="true">Structural<br />load axis <span>→</span></p>
        <ol class="loads" data-motion-loads>
          {ASSESSMENTS.map((a) => (
            <li class="load" style={`--h:${Math.round((a.weight / maxWeight) * 100)}`}>
              <span class="load-cap">{a.capability}</span>
              <span class="load-title display">{a.title}</span>
              <span class="load-pct display">{a.weight}%</span>
              <span class="load-meta">Due {formatCourseDate(a.due)} · end of Week {a.dueWeek}</span>
              <span class="load-stem" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
      </div>

      {/* The plan requires the same information as plain, readable text. */}
      <ul class="load-list">
        {ASSESSMENTS.map((a) => (
          <li>
            <b>{a.title}</b> — {a.weight}%, due {formatCourseDate(a.due)}. {a.summary}
          </li>
        ))}
      </ul>
      <p class="track-foot">
        Every brief, what counts as evidence, and what is not assessed:{" "}
        <a href={withBase("/assessments/")}>the assessment overview</a>.
      </p>
    </div>
  </section>

  {/* 6b --- STATIC WEEK 8 SPECIMEN (the Load Tester is not built) -------- */}
  <section class="band" aria-labelledby="order-title">
    <div class="inner order">
      <div>
        <p class="eyebrow">Specimen study</p>
        <h2 id="order-title" class="display">The order of layers changes the result.</h2>
        <p>
          The same four structural categories, assembled two ways. Moving the
          binding layer between the moist layer and the outer layer changes
          which interface is exposed first — the materials are identical, so
          the difference is structural, not culinary.
        </p>
        <p class="order-note">
          <Stamp state="revised" /> Assembly revised after the first interface failure.
        </p>
        <p>
          {hrefFor("week-08") ? (
            <a class="linkline" href={hrefFor("week-08")}>Week 8: The Order of Layers<span aria-hidden="true">→</span></a>
          ) : (
            <span class="pending">Week 8: The Order of Layers <em>in preparation</em></span>
          )}
        </p>
      </div>
      <figure class="order-figure">
        <LayerOrderStack />
        <figcaption>
          <ol class="order-legend">
            <li>Outer layer</li>
            <li>Moist layer — against the outer layer in the first order</li>
            <li>Binding layer — moved between them in the second</li>
            <li>Support layer</li>
            <li>Outer layer</li>
          </ol>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* 7 --- LECTURE AND FIELD MANUAL --------------------------------------- */}
  <section class="band" aria-labelledby="res-title">
    <div class="inner">
      <p class="eyebrow eyebrow--ruled">Resources</p>
      <h2 id="res-title" class="display xl">Use the evidence.</h2>

      <div class="res">
        <article class="res-item" aria-labelledby="res-deck">
          <LectureSleeve />
          <h3 id="res-deck" class="visually-hidden">
            Moisture Is a Load — the Week 4 lecture deck
          </h3>
          <p class="res-act">
            <a class="linkline" href={withBase("/lectures/moisture-is-a-load/")}>
              Open the Week 4 lecture deck<span aria-hidden="true">→</span>
            </a>
          </p>
        </article>

        <article class="res-item" aria-labelledby="res-manual">
          <FieldManual />
          <h3 id="res-manual" class="visually-hidden">
            The Field Manual — procedures, evidence and failure modes
          </h3>
          <p class="res-act">
            <a class="linkline" href={withBase("/field-manual/")}>
              Consult the Field Manual<span aria-hidden="true">→</span>
            </a>
          </p>
        </article>
      </div>
    </div>
  </section>

  {/* 8 --- COURSE DETAILS -------------------------------------------------- */}
  <section class="band band--details" aria-labelledby="det-title">
    <div class="inner">
      <h2 id="det-title" class="visually-hidden">Course details</h2>
      <ArchiveRule label={`${courseMeta.code} / experiment archived`} />
      <div class="det">
        <dl class="det-facts">
          <div><dt>Course</dt><dd>{courseMeta.code}</dd></div>
          <div><dt>Session</dt><dd>{courseMeta.session} {courseMeta.year}</dd></div>
          <div><dt>Duration</dt><dd>Twelve teaching weeks</dd></div>
          <div><dt>Teaching period</dt>
            <dd>{formatCourseDate(courseMeta.startDate)} – {formatCourseDate(courseMeta.endDate)}</dd></div>
          <div><dt>Level</dt><dd>{courseMeta.level}000-level undergraduate</dd></div>
        </dl>
        <div class="det-side">
          <p class="det-line">From definition to destructive testing. One load path.</p>
          <ul class="det-links">
            <li><a href={withBase("/course/")}>Course guide and learning outcomes</a></li>
            <li><a href={withBase("/sessions/")}>Semester structure</a></li>
            <li><a href={withBase("/assessments/")}>Assessment</a></li>
            <li><a href={withBase("/field-manual/")}>Field Manual</a></li>
            <li><a href={withBase("/policies/")}>Policies, safety and equivalent participation</a></li>
            <li><a href={withBase("/lectures/")}>Lectures</a></li>
            <li><a href={withBase("/people/")}>People</a></li>
          </ul>
          <p class="det-stamp"><Stamp state="archived" label="Experiment archived" /></p>
          <p class="det-quip">The evidence survived. The sandwich did not.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
