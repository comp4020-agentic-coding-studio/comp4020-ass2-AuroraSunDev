---
/**
 * The weeks index --- the semester's spine.
 *
 * Its job (plan.md, "Weeks Index") is to let a marker understand the whole
 * twelve weeks at a glance and move directly between non-adjacent weeks. So
 * it is one continuous load path with twelve rows on it, not twelve cards: the
 * structural line runs down the milestone column and every week hangs off it
 * in chronological order, which is also keyboard order.
 *
 * Nothing on this page implies completion. The course record supplies no
 * reliable current-week state --- the semester it describes is Semester 1
 * 2027 --- so no week is marked current, and there is no progress metric.
 */
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { getPublishedCollection } from "astro-course-university/content";
import { withBase } from "astro-theme-university/url";
import ArchiveRule from "../../components/course/ArchiveRule.astro";
import WeekGlyph from "../../components/course/WeekGlyph.astro";
import { courseMeta } from "../../course-config";
import { formatCourseDate } from "../../lib/dates";
import {
  ASSESSMENTS,
  INDEX_PHASES,
  WEEK_ARTEFACTS,
  WEEKS,
  indexPhaseOf,
} from "../../lib/semester";
import { sessionLabels, siteConfig } from "../../site-config";
import "../../styles/page.css";
import "../../styles/weeks.css";

const sessions = await getPublishedCollection("sessions");
const built = new Set(sessions.map((s) => s.id));
const assessments = await getPublishedCollection("assessments");
const builtAssessments = new Set(assessments.map((a) => a.id));

/* Which weeks carry a slide deck. Read from the lectures collection rather
   than kept as a flag beside the week: it was a flag, `lecture: true` was set
   on Week 4 alone, and when Week 8 gained a deck the badge did not follow it
   here or on the homepage --- and the legend below went on saying Week 4 was
   the only one. A `slides:` frontmatter field is the fact; anything else is a
   second copy of it waiting to disagree. */
const lectures = await getPublishedCollection("lectures");
const deckWeeks = new Set(
  lectures.filter((l) => l.data.slides).map((l) => l.data.week as number),
);

const milestoneAt = (week: number) => ASSESSMENTS.find((a) => a.dueWeek === week);
const shortDate = (iso: string) =>
  new Intl.DateTimeFormat("en-AU", { day: "2-digit", month: "short", timeZone: "UTC" })
    .format(new Date(`${iso}T00:00:00Z`))
    .toUpperCase();
---

<BaseLayout
  title={`${sessionLabels.plural} — ${courseMeta.code}`}
  description="Twelve weeks, one load path. Every teaching week's date, structural question and dominant artefact, with the four assessment milestones attached where they fall due."
  {...siteConfig}
  mainAttrs={{ class: "slop-page weeks" }}
>
  {/* --- Title, orientation and the four phases -------------------------- */}
  <section class="band band--tight" aria-labelledby="weeks-title">
    <div class="inner">
      <h1 id="weeks-title" class="page-title">Twelve weeks. One load path.</h1>
      <p class="lede">
        From definition to destructive testing, each week isolates one condition
        that determines whether a sandwich holds.
      </p>

      {/* The phases are stages of one path. On the phone they become four
          stacked records with the phase glyph beside each; on desktop they are
          four ruled columns with the path direction drawn between them. */}
      <ol class="phases" aria-label="The four phases of the semester">
        {INDEX_PHASES.map((p, i) => (
          <li class="phase">
            {i > 0 && <span class="phase-arrow" aria-hidden="true">→</span>}
            {/* The phone composition shows the numeral alone, as the mobile
                reference does; the word stays in the accessibility tree at
                every width. */}
            <span class="phase-num mono">
              <span class="phase-num-w">Phase </span>{p.numeral}
            </span>
            <span class="phase-glyph" aria-hidden="true">
              <WeekGlyph phase={p.glyph} />
            </span>
            <span class="phase-name display">{p.name}</span>
            <span class="phase-line">{p.line}</span>
            <span class="phase-weeks mono">
              Weeks {p.weeks[0]}–{p.weeks[1]}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* --- The twelve rows on one line ------------------------------------- */}
  <section class="band band--tight" aria-labelledby="track-title">
    <div class="inner">
      <h2 id="track-title" class="visually-hidden">The twelve teaching weeks</h2>

      {/* Column headings, desktop only: on the phone each field is labelled in
          place, because a header row eight rows up is not a label. */}
      <div class="colheads" aria-hidden="true">
        <span class="colhead">Week</span>
        <span class="colhead">Date</span>
        <span class="colhead">Title</span>
        <span class="colhead">Structural question</span>
        <span class="colhead colhead--ms">Assessment milestone</span>
        <span class="colhead colhead--art">Artefact</span>
        <span class="colhead colhead--act">Action</span>
      </div>

      <ol class="wk-list">
        {WEEKS.map((w) => {
          const phase = indexPhaseOf(w.week);
          const opensPhase = phase.weeks[0] === w.week;
          const milestone = milestoneAt(w.week);
          const { artefact } = WEEK_ARTEFACTS[w.week];
          const href = built.has(w.slug) ? withBase(`/sessions/${w.slug}/`) : undefined;
          const msHref =
            milestone && builtAssessments.has(milestone.slug)
              ? withBase(`/assessments/${milestone.slug}/`)
              : undefined;
          return (
            <>
              {opensPhase && (
                <li class="phase-break" aria-hidden="true">
                  <span class="mono">
                    Phase {phase.numeral} — {phase.name}
                  </span>
                </li>
              )}

              <li class:list={["wk", w.week === 12 && "wk--last"]}>
                {/* The structural line and this week's station on it. Drawn,
                    not announced: every field it marks is in the row's text. */}
                <span class="wk-rail" aria-hidden="true">
                  <span class:list={["wk-dot", milestone && "wk-dot--ms"]}></span>
                </span>

                <p class="wk-n display">{String(w.week).padStart(2, "0")}</p>

                <p class="wk-date mono">
                  <span class="visually-hidden">Teaching week commencing </span>
                  <span class="wk-date--short">{shortDate(w.date)}</span>
                  <span class="wk-date--long">{formatCourseDate(w.date)}</span>
                </p>

                <h3 class="wk-title">
                  {href ? (
                    <a href={href}>{w.title}</a>
                  ) : (
                    <span class="pending">{w.title}</span>
                  )}
                  {deckWeeks.has(w.week) && <span class="wk-deck mono">Lecture deck</span>}
                </h3>

                <p class="wk-q">{w.question}</p>

                <p class="wk-ms">
                  {milestone ? (
                    <>
                      <span class="wk-ms-mark" aria-hidden="true"></span>
                      {msHref ? (
                        <a class="mono" href={msHref}>
                          {milestone.title} {milestone.weight}%
                        </a>
                      ) : (
                        <span class="mono pending">
                          {milestone.title} {milestone.weight}%
                        </span>
                      )}
                      <span class="visually-hidden">
                        {" "}due {formatCourseDate(milestone.due)}
                      </span>
                    </>
                  ) : (
                    <span class="visually-hidden">No assessment milestone this week.</span>
                  )}
                </p>

                <div class="wk-art">
                  <WeekGlyph week={w.week} />
                  <span class="wk-art-name mono">{artefact}</span>
                </div>

                <p class="wk-act">
                  {href ? (
                    <a class="linkline" href={href}>
                      Open week<span aria-hidden="true">→</span>
                    </a>
                  ) : (
                    <span class="pending">
                      Open week <em>in preparation</em>
                    </span>
                  )}
                </p>
              </li>
            </>
          );
        })}
      </ol>
    </div>
  </section>

  {/* --- Legend and where to go next ------------------------------------- */}
  <section class="band band--alt band--last" aria-labelledby="legend-title">
    <div class="inner">
      <h2 id="legend-title" class="eyebrow eyebrow--ruled">Reading the load path</h2>
      <dl class="legend">
        <div class="legend-item">
          <dt>
            <span class="lg lg--station" aria-hidden="true"></span>
            Station
          </dt>
          <dd>
            One teaching week on the load path. Twelve stations, in chronological
            order, which is also the keyboard order.
          </dd>
        </div>
        <div class="legend-item">
          <dt>
            <span class="lg lg--ms" aria-hidden="true"></span>
            Assessment milestone
          </dt>
          <dd>
            A submission falls due at the end of this week. The weight is printed
            beside it; the four together total 100%.
          </dd>
        </div>
        <div class="legend-item">
          <dt>
            <span class="lg lg--deck mono" aria-hidden="true">Deck</span>
            Lecture deck
          </dt>
          <dd>
            The week carries a full slide deck as well as its page. {deckWeeks.size} of
            the twelve do.
          </dd>
        </div>
        <div class="legend-item">
          <dt>
            <span class="lg lg--art" aria-hidden="true">
              <WeekGlyph week={5} />
            </span>
            Artefact
          </dt>
          <dd>
            The evidence that leaves the session, drawn as the instrument that
            produces it. No two weeks produce the same artefact.
          </dd>
        </div>
      </dl>

      <p class="weeks-next">
        Where the weeks lead:{" "}
        <a href={withBase("/assessments/")}>the four assessments</a>,{" "}
        <a href={withBase("/policies/")}>the participation policies</a>.
      </p>
      <ArchiveRule label={`${courseMeta.code} / semester load path / ${courseMeta.session} ${courseMeta.year}`} />
      <p class="caveat">Semester status: load path continues.</p>
    </div>
  </section>
</BaseLayout>
