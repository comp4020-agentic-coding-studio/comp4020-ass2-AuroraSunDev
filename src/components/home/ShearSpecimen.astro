---
/**
 * The proposition specimen: one assembly under lateral shear, drawn on the
 * charcoal ground.
 *
 * Monochrome except for the one layer the observed failure happens at --- the
 * meat/cheese interface --- which is why exactly one band is red. The desktop
 * reference names each layer on a leader line and the mobile reference marks
 * them 01-04; numbered callouts carry both, and the numbers are resolved by
 * an ordinary HTML list beside the drawing rather than by text baked into the
 * SVG.
 */
---

<svg class="shear" viewBox="0 0 460 250" role="img" aria-labelledby="sh-t sh-d" focusable="false">
  <title id="sh-t">Sandwich cross-section under lateral shear load</title>
  <desc id="sh-d">
    Four layers seen edge on. Opposing horizontal arrows above and below show a
    shear load. The third layer is highlighted, where the layers have begun to
    slide relative to one another.
  </desc>

  <g class="sh-load" aria-hidden="true">
    <path d="M150 26 h180 m-8 -7 l8 7 l-8 7" />
    <path d="M330 224 h-180 m8 -7 l-8 7 l8 7" />
  </g>

  <g class="sh-stack">
    <path class="sh-layer" d="M96 56 h288 a14 14 0 0 1 0 40 h-288 a14 14 0 0 1 0 -40 z" />
    <path class="sh-layer" d="M96 100 q34 -9 70 0 q34 9 72 0 q34 -9 72 0 q30 8 74 0 v20 h-288 z" />
    <path class="sh-layer sh-layer--focus" d="M104 126 q36 12 74 0 q36 -12 74 0 q36 12 74 0 q30 -10 66 0 v20 h-288 z" />
    <path class="sh-layer" d="M96 154 h288 a14 14 0 0 1 0 40 h-288 a14 14 0 0 1 0 -40 z" />
  </g>

  <g class="sh-callout" aria-hidden="true">
    <g><rect x="398" y="64" width="30" height="20" rx="2" /><text x="413" y="78">01</text></g>
    <g><rect x="398" y="100" width="30" height="20" rx="2" /><text x="413" y="114">02</text></g>
    <g><rect x="398" y="128" width="30" height="20" rx="2" /><text x="413" y="142">03</text></g>
    <g><rect x="398" y="164" width="30" height="20" rx="2" /><text x="413" y="178">04</text></g>
  </g>

  <g class="sh-dim" aria-hidden="true">
    <path d="M64 56 v138 M58 56 h12 M58 194 h12" />
  </g>
</svg>

<style>
  .shear { width: 100%; height: auto; display: block; }

  .sh-layer {
    fill: none;
    stroke: var(--slop-charcoal);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  /* The one meaningful colour: the interface the failure was observed at. */
  .sh-layer--focus {
    fill: color-mix(in srgb, var(--slop-tomato) 34%, transparent);
    stroke: var(--slop-tomato);
    stroke-width: 2;
  }

  .sh-load {
    fill: none;
    stroke: var(--slop-tomato);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sh-callout rect { fill: none; stroke: var(--slop-tomato); stroke-width: 1.4; }
  .sh-callout text {
    fill: var(--slop-tomato);
    font-family: var(--slop-font-mono);
    font-size: 12px;
    text-anchor: middle;
  }

  .sh-dim { fill: none; stroke: var(--slop-charcoal); stroke-width: 1; opacity: 0.8; }
</style>
