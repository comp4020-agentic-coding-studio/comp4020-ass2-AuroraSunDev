---
/**
 * The specimen specification drawing: five layers, exploded, each annotated
 * with the analytical category it stands for.
 *
 * plan.md asks the Course Guide for "one annotated cross-section to distinguish
 * material, interface, load, observation and evidence, avoiding a decorative
 * finished sandwich". So this is a line drawing rather than a photograph --- the
 * page's image rule reserves realistic specimen imagery for the homepage and
 * for evidence-based specimen cases.
 *
 * The five layers are five different BODIES, and that is the whole point of
 * the redraw. They were five identical rectangular prisms distinguished only
 * by a fill, which made the drawing read as a colour key rather than as a
 * specimen: a reader could not see why a film and a pair of load-bearing
 * bodies are not the same kind of thing. Against the reference they are now a
 * rounded porous slab, a wavy continuous film, two discrete discs, a thin
 * recording sheet, and a second porous slab.
 *
 * Every body is drawn in plan and pushed through one oblique projection, so
 * the stack reads as one specimen taken apart rather than five drawings at
 * five angles --- and a disc stays a disc instead of being guessed at as an
 * ellipse. `PROJ` below is that projection, written once as an SVG matrix.
 *
 * The labels are drawn as SVG text so they sit on their leader lines, and the
 * whole figure carries one `aria-label` naming the stack in order. The page
 * prints a definition for each of the five categories beside it, so nothing
 * here is the only place a reader can learn what `interface` means.
 */

/* --- One projection for the whole stack --------------------------------- *
 * Plan space is W wide and PD deep, with the origin at the near-left corner
 * of a layer. The oblique push is (DX, -DY) at full depth, so a point (x, d)
 * lands at (X + x + d·DX/PD, base - d·DY/PD). Written as a matrix, any shape
 * drawn in plan --- a rounded rectangle, a circle, a wavy outline --- comes
 * out correctly projected without being re-derived by hand. */
const W = 232;
const PD = 100;
const DX = 58;
/* The vertical foreshortening has to be larger than a slab is thick, or the
   top face is no deeper on the page than the side and the two copies that
   draw the extrusion separate into two sheets floating one above the other.
   At DY 32 against a 30-unit slab they did exactly that. The reference's own
   proportion is about two to one; this is 52 against 26. */
const DY = 52;
const X = 48;
const KX = DX / PD;
const KY = DY / PD;

/** The plan-to-screen matrix for a layer whose near-front edge sits at `base`. */
const proj = (base: number) => `matrix(1 0 ${KX} ${-KY} ${X} ${base})`;

interface Layer {
  /** Screen y of the layer's near-front-bottom edge. */
  y: number;
  /** Thickness, in screen units --- a vertical push, unaffected by the projection. */
  t: number;
  label: string;
  kind: "porous" | "film" | "discrete" | "sheet";
}

/* `y` is the near-front-bottom edge. A layer occupies DY + t of page height
   above it, so the gaps below are what is left over --- kept between 14 and
   25 so the stack reads as exploded rather than as five separate drawings. */
const LAYERS: Layer[] = [
  { y: 150, t: 26, label: "Material", kind: "porous" },
  { y: 238, t: 11, label: "Interface", kind: "film" },
  { y: 326, t: 18, label: "Load", kind: "discrete" },
  { y: 404, t: 8, label: "Observation", kind: "sheet" },
  { y: 496, t: 26, label: "Evidence", kind: "porous" },
];

/* --- Plan outlines ------------------------------------------------------ */

/** A slab's plan: a rectangle with eased corners, as the reference draws it. */
const SLAB_R = 16;
const slabPlan =
  `M${SLAB_R} 0 H${W - SLAB_R} Q${W} 0 ${W} ${SLAB_R} V${PD - SLAB_R} ` +
  `Q${W} ${PD} ${W - SLAB_R} ${PD} H${SLAB_R} Q0 ${PD} 0 ${PD - SLAB_R} ` +
  `V${SLAB_R} Q0 0 ${SLAB_R} 0 Z`;

/**
 * A leaf: one closed outline whose edge ripples, so it reads as a material
 * that drapes rather than a sheet that was cut. Deterministic, not random ---
 * a redraw must not produce a different leaf.
 */
const leafPlan = (() => {
  const pts: string[] = [];
  const cx = W / 2;
  const cy = PD / 2;
  const n = 26;
  for (let i = 0; i < n; i++) {
    const a = (i / n) * Math.PI * 2;
    const ripple = 1 + 0.13 * Math.sin(i * 2.6) + 0.075 * Math.cos(i * 1.4);
    const x = cx + Math.cos(a) * (W / 2 - 6) * ripple;
    const y = cy + Math.sin(a) * (PD / 2 - 5) * ripple;
    pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
  }
  return `M${pts[0]} L${pts.slice(1).join(" L")} Z`;
})();

/** Two load-bearing bodies, side by side, each carrying where it touches. */
const DISCS = [
  { cx: W * 0.28, cy: PD / 2, r: 41 },
  { cx: W * 0.74, cy: PD / 2, r: 41 },
];

/** The recording sheet is inset: it documents the stack, it is not part of it. */
const SHEET_INSET = 10;

const LEADER_X = X + W + DX + 14;
const LABEL_X = 466;
const uid = "xspec";
---

<svg
  class="xspec"
  viewBox="0 70 620 460"
  role="img"
  aria-label="An exploded drawing of one specimen in five layers. From the top: a porous outer slab, labelled material; a rippled continuous film, labelled interface; two round load-bearing bodies side by side, labelled load; a thin recording sheet, labelled observation; and a second porous outer slab, labelled evidence."
>
  <defs>
    {/* Crumb. A three-dot tile on an 11px grid repeated visibly enough to
        read as a halftone screen rather than as a porous surface, so the
        tile is larger, carries more pores, and none of them share a row or
        a column with another. */}
    <pattern id={`${uid}-pore`} width="23" height="23" patternUnits="userSpaceOnUse">
      <circle class="pore" cx="3.1" cy="5.4" r="1.9" />
      <circle class="pore" cx="10.8" cy="1.7" r="1.1" />
      <circle class="pore" cx="17.6" cy="7.9" r="1.6" />
      <circle class="pore" cx="6.4" cy="13.2" r="1.3" />
      <circle class="pore" cx="14.1" cy="17.4" r="2.1" />
      <circle class="pore" cx="21.2" cy="14.6" r="0.9" />
      <circle class="pore" cx="1.4" cy="20.1" r="1.2" />
      <circle class="pore" cx="9.7" cy="21.8" r="0.8" />
    </pattern>
  </defs>

  {/* The assembly axis: where the layers came from, and where they return to.
      Dashed, because it is a construction line and not an edge. */}
  <path
    class="axis"
    d={`M${X} ${LAYERS[0].y - LAYERS[0].t} V${LAYERS[4].y} M${X + W} ${LAYERS[0].y - LAYERS[0].t} V${LAYERS[4].y}`}
  />

  {LAYERS.map((layer, i) => {
    const top = layer.y - layer.t;
    const mid = layer.y - layer.t / 2;
    /* The far-right corner, at mid-thickness: where the leader can touch the
       body without crossing it. */
    const labelY = mid - DY;
    return (
      <g class:list={["slab", `slab--${layer.kind}`]}>
        {(layer.kind === "porous" || layer.kind === "sheet") && (
          <g>
            {/* The body first, one thickness lower, then the lid over it. The
                sliver left showing between the two outlines IS the thickness
                --- the same construction the film and the discs use. Drawing
                a skirt instead meant pushing verticals through the oblique
                matrix, which sheared them into hooks at the corners. */}
            <g transform={proj(layer.y)}>
              <path class="face face--under" d={layer.kind === "sheet"
                ? `M${SHEET_INSET} ${SHEET_INSET} H${W - SHEET_INSET} V${PD - SHEET_INSET} H${SHEET_INSET} Z`
                : slabPlan} />
            </g>
            <g transform={proj(top)}>
              <path class="face face--lid" d={layer.kind === "sheet"
                ? `M${SHEET_INSET} ${SHEET_INSET} H${W - SHEET_INSET} V${PD - SHEET_INSET} H${SHEET_INSET} Z`
                : slabPlan} />
              {layer.kind === "porous" && (
                <path class="texture" d={slabPlan} fill={`url(#${uid}-pore)`} />
              )}
              {layer.kind === "sheet" && (
                <g>
                  {/* Two surface waves rather than a ruled line: the sheet is
                      thin enough to lie unevenly, which is what says it was
                      laid over the stack and not built into it. */}
                  <path class="record" d={`M${SHEET_INSET + 10} ${PD * 0.34} q 22 -8 44 0 t 44 0 t 44 0 t 42 0`} />
                  <path class="record" d={`M${SHEET_INSET + 10} ${PD * 0.66} q 22 -7 44 0 t 44 0 t 44 0 t 42 0`} />
                </g>
              )}
            </g>
          </g>
        )}

        {layer.kind === "film" && (
          <g>
            {/* Drawn twice, the lower copy offset by the thickness: a film has
                a depth you can see at its edge but no side you can measure. */}
            <g transform={proj(layer.y)}>
              <path class="film film--under" d={leafPlan} />
            </g>
            <g transform={proj(top)}>
              <path class="film" d={leafPlan} />
              <path
                class="filmline"
                d={`M26 ${PD * 0.44} q 18 -6 36 0 t 36 0 t 36 0 t 34 0`}
              />
            </g>
          </g>
        )}

        {layer.kind === "discrete" && (
          <g>
            {DISCS.map((d) => (
              <g>
                <g transform={proj(layer.y)}>
                  <circle class="disc disc--under" cx={d.cx} cy={d.cy} r={d.r} />
                </g>
                <g transform={proj(top)}>
                  <circle class="disc" cx={d.cx} cy={d.cy} r={d.r} />
                  {/* Three marks, so a disc reads as a body with a surface
                      rather than as a flat token. */}
                  <circle class="disc-mark" cx={d.cx - 15} cy={d.cy - 9} r="4" />
                  <circle class="disc-mark" cx={d.cx + 11} cy={d.cy + 3} r="5.5" />
                  <circle class="disc-mark" cx={d.cx - 2} cy={d.cy + 14} r="3" />
                </g>
              </g>
            ))}
          </g>
        )}

        {/* Leader and label. */}
        <path
          class="leader"
          d={`M${X + W + DX - 2} ${labelY + 4} H${LEADER_X + 86} H${LABEL_X - 12}`}
        />
        <circle class="leader-dot" cx={X + W + DX - 2} cy={labelY + 4} r="3" />
        <text class="label" x={LABEL_X} y={labelY + 9}>{layer.label.toUpperCase()}</text>
      </g>
    );
  })}

</svg>

<style>
  .xspec {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Paper-white solids with charcoal edges: a drawing, not a rendering. */
  .face {
    fill: var(--slop-paper);
    stroke: var(--slop-charcoal);
    stroke-width: 1.7;
    stroke-linejoin: round;
  }
  .face--lid { fill: var(--slop-paper); }

  /* The thickness: the body repeated one thickness lower, in a heavier wash,
     so the band left showing below the lid reads as the slab's own edge. */
  .face--under {
    fill: color-mix(in srgb, var(--slop-charcoal) 16%, var(--slop-paper));
  }

  .texture { stroke: none; }
  /* Crumb, not rust. The pores were toast-brown at 46%, which read as a
     tinted panel from a metre away rather than as a porous surface. */
  .pore { fill: color-mix(in srgb, var(--slop-charcoal) 34%, transparent); }

  /* The interface layer: a continuous film, in the green that on this site
     means a route that is holding. */
  /* The interface layer is the one solid in the drawing, as the reference
     has it: a dark green body among white ones. It is also the only layer a
     reader cannot see in a real assembled specimen, which is the reason to
     let it carry the figure's only fill. */
  .film {
    fill: var(--slop-lettuce);
    stroke: color-mix(in srgb, var(--slop-lettuce) 55%, var(--slop-charcoal));
    stroke-width: 1.7;
    stroke-linejoin: round;
  }
  .film--under {
    fill: color-mix(in srgb, var(--slop-lettuce) 70%, var(--slop-charcoal));
    stroke: color-mix(in srgb, var(--slop-lettuce) 40%, var(--slop-charcoal));
  }
  .filmline {
    fill: none;
    stroke: color-mix(in srgb, var(--slop-paper) 45%, transparent);
    stroke-width: 1.4;
  }

  /* The two load-bearing bodies are drawn like every other solid here:
     white, edged, marked. They were red, which on this site means a load
     being applied or an interface letting go --- neither is what a body
     sitting in an exploded view is doing, and the reference draws them in
     line only. The word LOAD on the leader is what names them. */
  .disc {
    fill: var(--slop-paper);
    stroke: var(--slop-charcoal);
    stroke-width: 1.7;
  }
  .disc--under {
    fill: color-mix(in srgb, var(--slop-charcoal) 16%, var(--slop-paper));
    stroke: var(--slop-charcoal);
  }
  .disc-mark {
    fill: none;
    stroke: color-mix(in srgb, var(--slop-charcoal) 55%, var(--slop-paper));
    stroke-width: 1.2;
  }

  /* The observation sheet: a record, so it carries a ruled line. */
  .record {
    fill: none;
    stroke: color-mix(in srgb, var(--slop-charcoal) 45%, var(--slop-paper));
    stroke-width: 1.2;
  }

  .axis {
    fill: none;
    stroke: var(--slop-charcoal);
    stroke-width: 1.1;
    stroke-dasharray: 6 5;
    opacity: 0.5;
  }

  .leader {
    fill: none;
    stroke: var(--slop-charcoal);
    stroke-width: 1.2;
  }
  .leader-dot { fill: var(--slop-charcoal); }

  .label {
    font-family: var(--slop-font-mono);
    font-size: 17px;
    letter-spacing: 0.08em;
    fill: var(--slop-lettuce);
  }

</style>
