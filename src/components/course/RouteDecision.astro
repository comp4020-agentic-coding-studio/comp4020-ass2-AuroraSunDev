---
/**
 * How to choose a participation route, as the decision it actually is.
 *
 * The page had this as a block quote: a question, then two sentences of
 * prose. That is the same information and it reads as advice, which is wrong
 * --- there is one question here, it has two answers, and both answers end in
 * a route that is marked identically. A reader deciding whether to handle
 * food should be able to see the whole decision at once and find themselves
 * in it, not parse it.
 *
 * Four nodes on one spine, as the reference draws it. The last is not a step:
 * it is the guarantee that the decision costs nothing to declare, which is
 * the part a student is most likely to doubt.
 */
interface Step {
  /** What the node says. Short: it is a token on a diagram, not a sentence. */
  key: string;
  /** Rendered as a tick rather than as text. */
  tick?: boolean;
  text: string;
  /** Marks a branch that leads somewhere, as an arrow does on a flow chart. */
  leads?: boolean;
}

const STEPS: Step[] = [
  { key: "?", text: "Can you safely and comfortably use a physical specimen?" },
  { key: "Yes", text: "Physical route available.", leads: true },
  { key: "No or unsure", text: "Choose a non-food analogue or supplied-evidence pack.", leads: true },
  { key: "", tick: true, text: "No diagnosis or disclosure is required, at any point, by anyone." },
];
---

<div class="rd">
  <h2 class="rd-h" id="choose-route">Choose a participation route</h2>

  <ol class="rd-flow" role="list">
    {
      STEPS.map((step) => (
        <li class="rd-step">
          <span class:list={["rd-node", step.key.length > 4 && "rd-node--wide"]} aria-hidden="true">
            {step.tick ? (
              <svg viewBox="0 0 24 24" focusable="false"><path d="M6.5 12.5 l3.6 3.6 l7.4 -8.2" /></svg>
            ) : (
              <span class="rd-key mono">{step.key}</span>
            )}
          </span>
          <p class="rd-text">{step.text}</p>
          {step.leads && (
            <span class="rd-lead" aria-hidden="true">
              <svg viewBox="0 0 44 10" focusable="false"><path d="M0 5 H38 m-7 -5 l7 5 l-7 5" /></svg>
            </span>
          )}
        </li>
      ))
    }
  </ol>

  <p class="rd-warn">
    <span class="rd-warn-fig" aria-hidden="true">
      {/* A balance, level. The claim is that the pans are equal, so the beam
          is drawn horizontal and the two pans at one height. */}
      <svg viewBox="0 0 40 40" focusable="false">
        <circle cx="20" cy="20" r="18.5" />
        <path d="M20 9 V29 M9 13 H31 M9 13 l-5 9 a5.5 5.5 0 0 0 10 0 Z M31 13 l-5 9 a5.5 5.5 0 0 0 10 0 Z M14 30 H26" />
      </svg>
    </span>
    <b class="mono">Do not confuse participation method with academic quality.</b>
  </p>
</div>

<style>
  .rd { margin: 2rem 0 2.5rem; }

  .rd-h {
    margin: 0 0 1rem;
    padding-bottom: 0.6rem;
    font-size: 1.125rem;
    border-bottom: var(--slop-rule-width) solid var(--slop-rule);
  }

  .rd-flow {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* One spine down the nodes. Drawn on the step rather than behind the list so
     it stops at the last node instead of running past it. */
  /* One constant: the circle's diameter is also the spine's column and half
     of it is where the connectors hang. Three literals drifted apart once. */
  .rd { --rd-node: 3.5rem; }
  .rd-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--rd-node) minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.55rem;
  }
  .rd-step + .rd-step::before {
    content: "";
    position: absolute;
    left: calc(var(--rd-node) / 2);
    top: 0;
    height: 0.55rem;
    width: var(--slop-rule-width);
    background: var(--slop-lettuce);
    translate: -50% 0;
  }
  .rd-step:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--rd-node) / 2);
    bottom: 0;
    height: 0.55rem;
    width: var(--slop-rule-width);
    background: var(--slop-lettuce);
    translate: -50% 0;
  }

  .rd-node {
    display: grid;
    place-items: center;
    width: var(--rd-node);
    height: var(--rd-node);
    border: var(--slop-rule-width) solid var(--slop-lettuce);
    border-radius: 50%;
    text-align: center;
  }
  /* `mono` is a `.slop-page` utility and this sits on an MDX page, so the
     face is named here instead of relying on a class that does not reach. */
  .rd-key {
    font-family: var(--slop-font-mono);
    font-size: 0.8125rem;
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--slop-lettuce);
  }
  /* "No or unsure" is three words in a circle; it only fits smaller, and the
     tracking has to come off too or the longest word touches the stroke. */
  .rd-node--wide .rd-key { font-size: 0.625rem; letter-spacing: 0.01em; }
  .rd-node svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--slop-lettuce);
    stroke-width: 2;
  }

  .rd-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  .rd-lead svg {
    display: block;
    width: 2.75rem;
    fill: none;
    stroke: var(--slop-charcoal);
    stroke-width: 1.4;
  }

  .rd-warn {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 1.25rem 0 0;
    padding-top: 1.1rem;
    border-top: var(--slop-rule-width) solid var(--slop-rule-hair);
    font-family: var(--slop-font-mono);
    font-size: 0.875rem;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slop-toast);
  }
  .rd-warn-fig { flex: 0 0 auto; }
  .rd-warn-fig svg {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    fill: none;
    stroke: var(--slop-toast);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  /* The arrow is a mark on a diagram, not a control: below the width where it
     has room beside the text it goes rather than wrapping under it. */
  @media (width < 34rem) {
    .rd { --rd-node: 3.1rem; }
    .rd-step { grid-template-columns: var(--rd-node) minmax(0, 1fr); }
    .rd-lead { display: none; }
  }
</style>
