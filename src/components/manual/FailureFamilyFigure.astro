  .face--soaked { fill: color-mix(in srgb, var(--slop-toast) 42%, var(--slop-paper)); }
  .face--soaked.face--side { fill: color-mix(in srgb, var(--slop-toast) 56%, var(--slop-paper)); }
  .face--damp { fill: color-mix(in srgb, var(--slop-toast) 20%, var(--slop-paper)); }
