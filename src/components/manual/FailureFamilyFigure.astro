  .texture { stroke: none; }
  .crumb { fill: color-mix(in srgb, var(--slop-charcoal) 34%, transparent); }
  .wetdot { fill: color-mix(in srgb, var(--slop-toast) 58%, transparent); }

  /* The platens belong to the rig, not the specimen: darker, and never red,
