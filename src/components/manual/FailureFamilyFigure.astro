  .platen--top { fill: color-mix(in srgb, var(--slop-charcoal) 12%, var(--slop-paper)); }
  .platen--front { fill: color-mix(in srgb, var(--slop-charcoal) 24%, var(--slop-paper)); }
  .platen--side { fill: color-mix(in srgb, var(--slop-charcoal) 34%, var(--slop-paper)); }
  .platen { stroke: none; }

  .support {
    fill: color-mix(in srgb, var(--slop-charcoal) 88%, transparent);
    stroke: none;
  }

  /* Where the specimen used to reach. Dashed, so the was-height and the
     is-height differ in line style and not only in position. */
  .ghost {
    fill: none;
    stroke: var(--slop-charcoal);
    stroke-width: 1;
    stroke-dasharray: 5 4;
    opacity: 0.55;
  }

  /* A measurement, not a force: charcoal, thin, and barbed at both ends. */
  .dim {
    fill: none;
    stroke: var(--slop-charcoal);
    stroke-width: 1;
    stroke-linejoin: miter;
  }

  /* The front's position, which is the whole claim in SOAK. */
  .front {
    fill: none;
    stroke: var(--slop-toast);
    stroke-width: 1.6;
    stroke-dasharray: 5 3;
  }
  .moisture {
    fill: none;
    stroke: var(--slop-toast);
    stroke-width: 1.5;
  }
  .drop {
